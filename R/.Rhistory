# Define parameters
Z <- qnorm(0.975)  # Z-score for 95% confidence level (1.96)
sigma <- 1.2       # Estimated standard deviation from previous studies
E <- 0.3           # Desired margin of error
# Calculate sample size
n <- (Z^2 * sigma^2) / (E^2)
ceiling(n)  # Round up to the next whole number
?qt
qt(p=.05, df=22, lower.tail=TRUE)
qt(p=.05/2, df=22, lower.tail=FALSE)
qt(p=.05/2, df=1165, lower.tail=FALSE)
