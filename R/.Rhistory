Produto = factor(rep(c("Produto_A", "Produto_B", "Produto_C"), length.out = 20)), # 3 produtos
Doce = sample(c(0, 1), 20, replace = TRUE),
Ácido = sample(c(0, 1), 20, replace = TRUE),
