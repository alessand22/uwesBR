head(dados_CATA)
set.seed(123)
consumidores <- paste0("Consumidor_", 1:20) # Nomeando consumidores
produtos <- c("Produto_A", "Produto_B", "Produto_C") # Lista de produtos
# Expandindo os dados para que cada consumidor avalie todos os produtos
dados_CATA <- expand.grid(Consumidor = consumidores, Produto = produtos)
# Adicionando atributos sensoriais com respostas binárias (0 = não selecionado, 1 = selecionado)
dados_CATA$Doce <- sample(c(0, 1), nrow(dados_CATA), replace = TRUE)
dados_CATA$Ácido <- sample(c(0, 1), nrow(dados_CATA), replace = TRUE)
dados_CATA$Crocante <- sample(c(0, 1), nrow(dados_CATA), replace = TRUE)
dados_CATA$Aromático <- sample(c(0, 1), nrow(dados_CATA), replace = TRUE)
# Visualizando parte dos dados
head(dados_CATA, n = 10)
tail(dados_CATA, n = 10)
