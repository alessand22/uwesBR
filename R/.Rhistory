#install.packages("FactoMineR")
#install.packages("factoextra") # Para visualização dos resultados
library(FactoMineR)
library(factoextra)
dados <- data.frame(
Sexo = factor(sample(c("Masculino", "Feminino"), 30, replace = TRUE)),
Idade = factor(sample(c("Jovem", "Adulto", "Idoso"), 30, replace = TRUE)),
Preferencia_Bebida = factor(sample(c("Café", "Chá", "Suco", "Refrigerante"), 30, replace = TRUE)),
Preferencia_Musica = factor(sample(c("Rock", "Pop", "Clássica", "Jazz", "Eletrônica"), 30, replace = TRUE))
)
res.mca <- MCA(dados, graph = FALSE) # Executa a ACM
get_mca_var(res.mca)
fviz_mca_var(res.mca, repel = T)
x11()
fviz_mca_var(res.mca, repel = T)
fviz_mca_biplot(res.mca, habillage = grupo , addEllipses = TRUE, repel = T)
dados
grupo <- as.factor(dados$Idade)
fviz_mca_biplot(res.mca, habillage = grupo , addEllipses = TRUE, repel = T)
fviz_mca_biplot(res.mca, habillage = grupo ,
addEllipses = TRUE, repel = T,
geom.ind = "point")
fviz_mca_biplot(res.mca, habillage = grupo , addEllipses = TRUE, repel = T)
fviz_mca_biplot(res.mca, habillage = grupo ,
addEllipses = TRUE, repel = T,
geom.ind = "point")
acm_result <- MCA(dados, graph = FALSE) # Executa a ACM
summary(acm_result) # Exibe informações gerais
fviz_mca_biplot(acm_result, repel = TRUE) # Gráfico biplot
# Contribuição das variáveis para os eixos principai
fviz_mca_var(acm_result, choice = "var")
get_eigenvalue(acm_result)
